# ==============================================================================
# JalRaksha — Central Environment & Secrets Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS BEFORE RUNNING
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# System Environment
ENVIRONMENT=development  # development, staging, production
DEMO_MODE=true           # set to true to enable synthetic demo data provider

# PostgreSQL + PostGIS Database Configuration
POSTGRES_DB=jalraksha_db
POSTGRES_USER=jalraksha_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jalraksha_user:change_this_secure_password@database:5432/jalraksha_db

# Redis Caching & Message Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# FastAPI Security & JWT Secrets
JWT_SECRET_KEY=change_this_jwt_secret_key_to_a_long_random_string_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Mapbox API Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here

# Firebase Cloud Messaging (FCM) & Authentication
FIREBASE_PROJECT_ID=jalraksha-prod
FIREBASE_CREDENTIALS_PATH=/etc/jalraksha/firebase-service-account.json

# SMS Gateway Credentials (Twilio / Local Carrier Gateway)
SMS_GATEWAY_PROVIDER=mock  # mock, twilio, local_gateway
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=JALRKSH

# S3-Compatible / Firebase Object Storage
STORAGE_PROVIDER=mock  # mock, s3, firebase
S3_BUCKET_NAME=jalraksha-citizen-reports
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT_URL=https://s3.amazonaws.com

# Cors & Client Security Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]
